generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           Int       @id @default(autoincrement())
  username     String    @unique
  passwordHash String
  createdAt    DateTime  @default(now())
  messages     Message[]
}

model Message {
  id        Int       @id @default(autoincrement())
  content   String?
  createdAt DateTime  @default(now())
  updatedAt DateTime?
  deletedAt DateTime?
  ownerId   Int
  owner     User      @relation(fields: [ownerId], references: [id])
}
